[
  {
    "id": "hikvision",
    "name": "Hikvision",
    "defaultPort": 554,
    "channel": true,
    "entries": [
      {
        "main": "/Streaming/Channels/{ch}01",
        "sub": "/Streaming/Channels/{ch}02",
        "third": null,
        "port": null,
        "note": "IP cameras: ch=1. NVRs: channel x 100 + stream (01 main, 02 sub). On hybrid DVRs, IP channels continue after the analog channels (e.g. 1701 = first IP camera; source: https://us-legacy.hikvision.com/sites/default/files/tb/tb_rtsp_and_http_urls_120915us.pdf).",
        "source": "https://supportusa.hikvision.com/support/solutions/articles/17000129064-how-do-i-get-my-rtsp-stream-"
      },
      {
        "main": "/ISAPI/Streaming/channels/{ch}01",
        "sub": "/ISAPI/Streaming/channels/{ch}02",
        "third": "/ISAPI/Streaming/channels/{ch}03",
        "port": null,
        "note": "ID = channel x 100 + stream (1 main, 2 sub, 3 third). 103 is derived from the official formula; the documentation gives no example of it.",
        "source": "https://enpinfo.hikvision.com/unzip/20201110210551_77443_doc/GUID-515FF2B5-5E01-4F03-8B81-4CA5BD621965.html"
      },
      {
        "main": "/Streaming/Channels/1",
        "sub": null,
        "third": null,
        "port": null,
        "note": "Fixed candidate path used by Frigate (no channel number).",
        "source": "https://github.com/blakeblackshear/frigate/blob/dev/frigate/api/camera.py"
      },
      {
        "main": "/PSIA/streaming/channels/101",
        "sub": "/PSIA/streaming/channels/102",
        "third": null,
        "port": null,
        "note": "Old PSIA path (2013-era DS-2CD20xx, etc.).",
        "source": "https://github.com/CamioCam/rtsp/blob/master/cameras/paths.csv (Apache-2.0) row 'Hikvision DS-2CD2032-I etc.'; maker doc cited by CamioCam: http://www.hikvision.com/UploadFile/image/2013061411054615328.pdf"
      }
    ]
  },
  {
    "id": "dahua",
    "name": "Dahua",
    "defaultPort": 554,
    "channel": true,
    "entries": [
      {
        "main": "/cam/realmonitor?channel={ch}&subtype=0",
        "sub": "/cam/realmonitor?channel={ch}&subtype=1",
        "third": "/cam/realmonitor?channel={ch}&subtype=2",
        "port": null,
        "note": "channel starts at 1; on an NVR, use the channel number. subtype: 0 main, 1 sub stream 1, 2 sub stream 2. A stream that is disabled or does not exist returns an error.",
        "source": "https://material.dahuasecurity.com/uploads/cpq/DOR/PUM0001826/Dahua-Network-Camera-Web-5.0_Operation-Manual_V1.0.6.pdf; https://support.amcrest.com/hc/en-us/article_attachments/360012029291 (Amcrest HTTP API, 4.1.1 Get real-time stream, pp. 17-18); same wording in the Dahua CGI document https://ftp.asm.cz/Dahua/kamerove_systemy/SDK&API/CGI_snapshot,stream.pdf (distributor's copy)"
      }
    ]
